
<div class="container mt-5" style="max-width: 1100px;">

  <!-- Company Header -->
  <div class="mb-5">
    <h1 class="fw-bold mb-1">
      <%= @company["name"] %>
    </h1>

    <h5 class="text-muted">
      <%= @company["city"] %>, <%= @company["state"] %>
    </h5>
  </div>

  <div class="row g-5">

    <!-- LEFT COLUMN -->
    <div class="col-md-5">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
          Contacts
        </h2>

        <a
          href="/contacts/new?company_id=<%= @company["id"] %>"
          class="btn btn-primary btn-sm">
          New Contact
        </a>

      </div>

      <% for contact in @contacts %>

        <div class="card mb-3 shadow-sm border-0">

          <div class="card-body py-3">

            <div class="d-flex align-items-center">

              <!-- Avatar -->
              <div class="me-3">

                <img
                  src="https://cdn-icons-png.flaticon.com/512/847/847969.png"
                  width="55"
                  height="55"
                  class="rounded-circle">

              </div>

              <!-- Contact Info -->
              <div>

                <a
                  href="/contacts/<%= contact["id"] %>"
                  class="text-decoration-none">

                  <div class="fw-semibold fs-5">
                    <%= contact["first_name"] %>
                    <%= contact["last_name"] %>
                  </div>

                </a>

                <div class="text-muted">
                  Contact
                </div>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-md-7">

      <h2 class="fw-bold mb-4">
        Sales Activity
      </h2>

      <!-- Activity 1 -->
      <div class="mb-5">

        <p class="fw-semibold mb-2">
          Call between Tim Cook and Brian on Monday, December 23:
        </p>

        <p class="text-muted">
          Hey man, when is that new iPhone coming out?
        </p>

      </div>

      <!-- Activity 2 -->
      <div class="mb-5">

        <p class="fw-semibold mb-2">
          Email between Katherine Adams and Ben on Thursday, November 14:
        </p>

        <p class="text-muted">
          Hi Katherine, just checking on the status of that agreement we discussed.
        </p>

      </div>

      <!-- Form -->
      <div class="mt-5">

        <h2 class="fw-bold mb-4">
          Log a new sales activity
        </h2>

        <div class="mb-3">

          <label class="form-label fw-semibold">
            With
          </label>

          <select class="form-select w-auto">

            <% for contact in @contacts %>

              <option>
                <%= contact["first_name"] %>
                <%= contact["last_name"] %>
              </option>

            <% end %>

          </select>

        </div>

        <div class="mb-3">

          <textarea
            class="form-control"
            rows="5"
            placeholder="Enter sales activity notes here..."></textarea>

        </div>

        <button class="btn btn-success px-4">
          Save Activity
        </button>

      </div>

    </div>

  </div>

  <!-- Bottom Buttons -->
  <div class="mt-5 pt-3 border-top">

    <a
      href="/companies"
      class="btn btn-secondary me-2">
      Back to All Companies
    </a>

    <% if User.find_by({ "id" => session["user_id"] }) != nil %>

      <a
        href="/companies/<%= @company["id"] %>/edit"
        class="btn btn-warning me-2">
        Edit Company
      </a>

      <form
        action="/companies/<%= @company["id"] %>"
        method="post"
        class="d-inline">

        <input
          type="hidden"
          name="_method"
          value="delete">

        <button class="btn btn-danger">
          Delete Company
        </button>

      </form>

    <% end %>

  </div>

</div>
```
